WORKER_URL=https://your-worker-domain.example.com
UPLOAD_TOKEN=replace_with_worker_upload_token
SOURCE=cmcc-router-01

OPERATOR=CMCC
SCAN_INTERVAL_SECONDS=7200
RUN_ON_START=1
UPLOAD_AFTER_SCAN=1

SLA_LATENCY_MS=30
SLA_SPEED_MB=20
REQUIRED_COUNT=10
HEALTH_CHECK=1
CFST_REPLENISH=1

MAX_ROUNDS=3
MAX_CANDIDATES=24
PARALLEL_DOWNLOADS=24
DOWNLOAD_BYTES=5000000
CURL_TIME_LIMIT=15
PER_REQUEST_SLEEP=1
ROUND_SLEEP=10
CFST_THREADS=120
CFST_TESTS=4
CFST_DOWNLOADS=20
